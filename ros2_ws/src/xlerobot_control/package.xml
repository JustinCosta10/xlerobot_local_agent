<?xml version="1.0"?>
<package format="3">
  <name>xlerobot_control</name><version>0.2.0</version>
  <description>Shared ros2_control controllers and verified joint transport for XLeRobot.</description>
  <maintainer email="justin@example.com">Justin</maintainer><license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend><depend>pluginlib</depend>
  <depend>rclcpp</depend><depend>rclcpp_lifecycle</depend><depend>sensor_msgs</depend>
  <exec_depend>controller_manager</exec_depend><exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend><exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>xlerobot_description</test_depend><test_depend>std_msgs</test_depend>
  <test_depend>controller_manager_msgs</test_depend><test_depend>ament_index_python</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
