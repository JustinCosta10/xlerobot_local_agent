Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /__NS__/robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Map
      Name: Live global costmap
      Enabled: true
      Alpha: 0.6
      Color Scheme: costmap
      Topic:
        Value: /__NS__/global_costmap/costmap
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Color: 40; 220; 100
      Line Style: Billboards
      Line Width: 0.04
      Topic:
        Value: /__NS__/plan
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera points
      Enabled: false
      Size (Pixels): 2
      Topic:
        Value: /camera/depth/points
        Reliability Policy: Best Effort
    - Class: nvblox_rviz_plugin/NvbloxMesh
      Name: Reconstructed mesh
      Enabled: true
      Topic:
        Value: /__NS__/nvblox_node/mesh
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Pitch: 1.1
      Yaw: 0
      Focal Point:
        X: -1.5
        Y: 0
        Z: 0
